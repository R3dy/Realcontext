{
  "name": "realcontext",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "OpenCode plugin: complete visibility into everything taking up context in a session — status split (system prompt / skills / MCPs / rules / conversation) + granular /context drill-down.",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "context",
    "tokens",
    "statusline",
    "context-window"
  ],
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "realcontext": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.0.0",
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
